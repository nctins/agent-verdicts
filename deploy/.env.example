# Image name prefix, e.g. "youruser/" once images are on Docker Hub. Empty = local images.
IMAGE_PREFIX=
# Release version, e.g. 0.1.0-beta
VERSION=
# REQUIRED: change it. Letters and digits only (it goes into a connection URL).
POSTGRES_PASSWORD=
# Host port for the web UI and /mcp
PORT=8080
# Lockout after too many wrong passwords or setup codes (Go duration, e.g. 30s). Empty = 15m.
#LOGIN_LOCKOUT=15m
# Mac (Apple Silicon): TEI_TAG=cpu-arm64-1.9.4 and TEI_PLATFORM=linux/arm64
#TEI_TAG=cpu-1.9.4
#TEI_PLATFORM=linux/amd64
